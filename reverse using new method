import java.util.*;

public class Main {
    public static void main(String[] args) {
      Scanner sc=new Scanner(System.in);
      int n=sc.nextInt();
      Node head=null;
      Node temp=null;
      for(int i=0;i<n;i++)
      {
        int val=sc.nextInt();
        Node nn=new Node(val);
        if(head==null)
        {
          head=nn;
          temp=nn;
        }
        else{
          temp.next=nn;
          temp=nn;
        }
      }
      head=rev(head);
      Node t=head;
      while(t!=null)
      {
        System.out.print(t.data+" ");
        t=t.next;
      }
    }
    public static Node rev(Node head)
    {
      Node prev=null;
      Node current=head;
      while(current!=null)
      {
        Node nextt=current.next;
        current.next=prev;
        prev=current;
        current=nextt;

      }
      head=prev;
      return head;
    }
}
class Node 
{
  int data;
  Node next;
  Node(int data)
  {
    this.data=data;
    next=null;
  }
}
